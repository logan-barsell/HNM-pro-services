# Public form endpoints for static export (no secrets).
# Leave blank until a hosted form provider is selected.
# Example: https://formspree.io/f/xxxxxxxx

NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_CONSULTATION_FORM_ENDPOINT=

# Google Places API key for `npm run sync:reviews` / weekly GitHub Action.
# Server/CI only — never prefix with NEXT_PUBLIC_.
# Place ID + public profile/review URLs live in src/content/googleReviews.config.js

GOOGLE_PLACES_API_KEY=
